# KargoPazar API environment (App Runner -> Configuration -> Environment variables).
# Double underscore (__) is the .NET configuration section separator. Never commit real values.

ASPNETCORE_ENVIRONMENT=Production

# MySQL 8 (AWS RDS). Create the database/user with database/000_CreateDatabase.sql first.
ConnectionStrings__Default=Server=<rds-endpoint>;Port=3306;Database=kargopazar;User=kargopazar_app;Password=<password>;SslMode=Required;

# Optional, default 8.0.36-mysql (used instead of AutoDetect so startup needs no DB round trip)
Db__ServerVersion=8.0.36-mysql

# JWT: at least 32 random characters (e.g. `openssl rand -base64 48`). Required, no fallback.
Jwt__SigningKey=<random-48-chars>
Jwt__Issuer=kargopazar-api
Jwt__Audience=kargopazar-panel
Jwt__ExpiryHours=12

# Allowed browser origins (landing + panel). When none are set, Production allows
# https://kargopazar.com and https://www.kargopazar.com only.
Cors__AllowedOrigins__0=https://www.kargopazar.com
Cors__AllowedOrigins__1=https://kargopazar.com
Cors__AllowedOrigins__2=https://main.<amplify-app-id>.amplifyapp.com

# Optional: time zone used to turn relative seed dates into absolute ones (default Europe/Istanbul)
Seed__TimeZone=Europe/Istanbul
