<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KargoPazar</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
  </ItemGroup>

  <!-- Seed JSON has a single source: the panel's seed folder. It is embedded (not copied)
       so the image carries it; the Docker build context is therefore the repo root. -->
  <ItemGroup>
    <EmbeddedResource Include="..\frontend\src\app\data\seed\*.json" Link="Seed\%(Filename)%(Extension)" LogicalName="KargoPazar.Seed.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Data\collections.json" LogicalName="KargoPazar.Data.collections.json" />
    <Content Remove="Data\collections.json" />
  </ItemGroup>

</Project>
