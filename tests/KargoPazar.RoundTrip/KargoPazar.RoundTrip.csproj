<Project Sdk="Microsoft.NET.Sdk">

  <!-- Round-trip / consistency checks that run without MySQL (SQLite in-memory stands in for
       the database). Run: dotnet run, project tests/KargoPazar.RoundTrip -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KargoPazar.RoundTrip</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\KargoPazar.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
  </ItemGroup>

</Project>
